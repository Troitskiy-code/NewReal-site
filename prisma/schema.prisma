generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? 
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Character {
  id                String   @id @default(cuid())
  name              String
  description       String?
  appearance        String?
  tags              String?
  imageUrl          String?
  isPublic          Boolean  @default(false)
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  messages          Message[]
  favorites         Favorite[]
  memories          Memory[]

  // Новые поля для редактора WetDreams
  greeting          String?   // Первое сообщение
  scenario          String?   // Сценарий и окружение
  exampleDialogs    String?   // Примеры диалогов
  imageLora         String?   // Аватар для улучшенной генерации
  voice             String?   // Голос
  descriptionCard   String?   // Описание карточки персонажа (не влияет на поведение)
  avatarPrompt      String?   @db.Text // Описание для генерации аватара
}

model Model {
  id                   String   @id @default(cuid())
  name                 String   @unique
  displayName          String
  pricePer1MInput      Float?
  pricePer1MOutput     Float?
  priceVC              Int      @default(0)
  maxContextTokens     Int      @default(4000)
  description          String?
  isFreeForSubscribers Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  users                User[]
}

model Message {
  id          String   @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  chatId      String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   // "user" или "assistant"
  content     String   @db.Text
  createdAt   DateTime @default(now())
  embedding   MessageEmbedding?

  @@index([userId, characterId])
  @@index([userId, chatId])
}

model MessageEmbedding {
  id        String   @id @default(cuid())
  messageId String   @unique
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(1536)")
  createdAt DateTime @default(now())
}

model Memory {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary     String    @db.Text
  createdAt   DateTime  @default(now())

  @@unique([userId, characterId])
  @@index([characterId])
}

model Favorite {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([userId, characterId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String        @id @default(cuid())
  name               String?
  email              String?       @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  credits            Int           @default(0)
  realCoins          Int           @default(0)
  verseCoins         Int           @default(0)
  subscriptionType         String?   @default("none")
  subscriptionEnd          DateTime?
  pendingSubscriptionType  String?
  pendingSubscriptionEnd   DateTime?
  bonusStreak        Int           @default(0)
  lastBonusDate      DateTime?
  dailyRequests      Int           @default(0)
  dailyRequestsDate  DateTime      @default(now())
  lastDailyBonus     DateTime?
  avatarTokens       Int           @default(10)
  lastTokenReplenish DateTime      @default(now())
  tokensUsedThisMonth Int          @default(0)
  lastTokenMonth     DateTime      @default(now())
  referralCode       String?       @unique
  referredBy         String?
  createdAt          DateTime      @default(now())
  selectedModelId    String?
  selectedModel      Model?        @relation(fields: [selectedModelId], references: [id])
  isSubscribed       Boolean       @default(false)
  customApiKey       String?
  accounts           Account[]
  sessions           Session[]
  creations          Creation[]
  instances          AppInstance[]
  characters         Character[]
  messages           Message[]
  favorites          Favorite[]
  memories           Memory[]
  transactions       Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  type        String
  description String
  createdAt   DateTime @default(now())
}

model AppInstance {
  id         String     @id @default(cuid())
  name       String
  templateId String
  config     String?    
  createdAt  DateTime   @default(now())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creations  Creation[]
}

model Creation {
  id           String       @id @default(cuid())
  prompt       String?      
  aspectRatio  String?
  resolution   String?
  createdAt    DateTime     @default(now())
  userId       String
  requestId    String?      @unique
  status       String       @default("processing")
  error        String?     
  appId        String?
  inputImage   String?      
  resultImage  String?      
  creditCost   Int          @default(1)
  customData   String?      
  greeting     String?      
  name         String?
  systemPrompt String?      
  category     String?
  imageUrl     String?      
  isPack       Boolean      @default(false)
  
  app          AppInstance? @relation(fields: [appId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
