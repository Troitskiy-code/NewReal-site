generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? 
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Character {
  id                String   @id @default(cuid())
  name              String
  slug              String?  @unique
  description       String?
  appearance        String?
  tags              String?
  imageUrl          String?
  isPublic          Boolean  @default(false)
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastActive        DateTime @default(now())
  privateMemory     Json?
  publicMemory      Json?
  memoryPermissions Json?
  messages          Message[]
  favorites         Favorite[]
  memories          Memory[]
  coreMemories      CoreMemory[]
  episodicMemories  EpisodicMemory[]
  memoryEntries     MemoryEntry[]
  worldEvents          WorldEvent[] @relation("CharacterEvents")
  initiatedWorldEvents WorldEvent[] @relation("InitiatedEvents")
  personaSelections    PersonaSelection[]
  scopedPersonas       Persona[]
  chatThreads          ChatThread[]

  // Новые поля для редактора WetDreams
  greeting          String?   // Первое сообщение
  scenario          String?   // Сценарий и окружение
  exampleDialogs    String?   // Примеры диалогов
  imageLora         String?   // Аватар для улучшенной генерации
  voice             String?   // Голос
  descriptionCard   String?   // Описание карточки персонажа (не влияет на поведение)
  avatarPrompt      String?   @db.Text // Описание для генерации аватара
  totalMessages     Int       @default(0) // Накопительное число сообщений (не уменьшается при очистке чата)

  name_en           String?
  description_en    String?
  descriptionCard_en String?
  appearance_en     String?
  greeting_en       String?
  scenario_en       String?
  exampleDialogs_en String?
  avatarPrompt_en   String?   @db.Text
  publicMemory_en   Json?
  privateMemory_en  Json?
  systemPrompt      String?   @db.Text
  // Legacy text is retained; unknown provenance is never auto-converted into v2 rules.
  legacyPromptArchive String? @db.Text
  promptOrigin      String    @default("unknown")
  promptBuilderVersion Int    @default(2)
  roleplayMode      String    @default("character")
  roleplayStyle     String    @default("mixed")
  rpConfig          Json?
  promptStates      ChatPromptState[]
  promptMigrations  PromptMigrationEntry[]
  generationItem    CharacterGenerationItem?
  moderationStatus    String?
  moderationReason    String?   @db.Text
  moderationWarnedAt  DateTime?
  violationCount      Int       @default(0)

  @@index([isPublic])
  @@index([totalMessages])
  @@index([createdAt])
  @@index([name])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([isPublic, createdAt])
  @@index([isPublic, totalMessages])
  @@index([lastActive])
}

model Model {
  id                   String   @id @default(cuid())
  name                 String   @unique
  displayName          String
  pricePer1MInput      Float?
  pricePer1MOutput     Float?
  priceVC              Int      @default(0)
  maxContextTokens     Int      @default(4000)
  description          String?
  isFreeForSubscribers Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  users                User[]
}

model Message {
  id          String   @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // Legacy: always the character id. The story is threadId.
  chatId      String?
  // Nullable until scripts/backfill-chat-threads.mjs has assigned every legacy row.
  threadId    String?
  thread      ChatThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   // "user" или "assistant"
  content     String   @db.Text
  finishReason String? // "stop" or "length"; null for legacy and non-generated messages
  createdAt   DateTime @default(now())
  isAutoEvent Boolean  @default(false)
  embedding   MessageEmbedding?
  deepinfraEmbedding MessageEmbeddingDeepinfra?

  @@index([userId, characterId])
  @@index([userId, chatId])
  @@index([threadId, createdAt])
}

// An independent story with one character (single hero, universe or group).
// Messages, memory, persona and prompt state (scopeKey "thread:<id>") belong to it.
model ChatThread {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId   String
  character     Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  personaId     String?
  persona       Persona?   @relation(fields: [personaId], references: [id], onDelete: SetNull)
  // Per user+character ordinal for the automatic title ("Story N").
  number        Int        @default(1)
  title         String?
  status        String     @default("active") // active | archived
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  // Last message, or creation time: the default story and "continue" use it.
  lastMessageAt DateTime   @default(now())
  messages         Message[]
  memories         Memory[]
  coreMemories     CoreMemory[]
  episodicMemories EpisodicMemory[]
  memoryEntries    MemoryEntry[]

  @@index([userId, characterId, status, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@index([personaId])
}

model MessageEmbedding {
  id        String   @id @default(cuid())
  messageId String   @unique
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(1536)")
  createdAt DateTime @default(now())
}

// Qwen/Qwen3-Embedding-0.6B, 1024 dimensions, document vectors without instructions.
// A different model/preprocessing version requires a new isolated store.
model MessageEmbeddingDeepinfra {
  id        String @id @default(cuid())
  messageId String @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(1024)")
  createdAt DateTime @default(now())
}

model EmbeddingBackfillLease {
  id         String @id
  owner      String
  leaseUntil DateTime
}

model Memory {
  id                     String    @id @default(cuid())
  characterId            String
  character              Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId               String?   @unique
  thread                 ChatThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  summary                String    @db.Text
  createdAt              DateTime  @default(now())
  lastSummarizedAt       DateTime?
  summarizedMessageCount Int       @default(0)

  @@index([userId, characterId])
  @@index([characterId])
}

model WorldEvent {
  id           String     @id @default(cuid())
  characterId  String
  character    Character  @relation("CharacterEvents", fields: [characterId], references: [id], onDelete: Cascade)
  initiatorId  String?
  initiator    Character? @relation("InitiatedEvents", fields: [initiatorId], references: [id], onDelete: SetNull)
  type         String
  participants String[]
  description  String     @db.Text
  timestamp    DateTime   @default(now())
  importance   Int        @default(1)
  location     String?

  @@index([characterId])
  @@index([characterId, timestamp])
  @@index([initiatorId])
}

enum MemoryEntryType {
  summary
  core
  episodic
}

model CoreMemory {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  threadId    String?   @unique
  thread      ChatThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  content     String    @db.Text
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([userId, characterId])
  @@index([characterId])
}

model EpisodicMemory {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  threadId    String?
  thread      ChatThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  event       String    @db.Text
  timestamp   DateTime  @default(now())
  importance  Int       @default(1)

  @@index([userId, characterId, timestamp])
  @@index([threadId, timestamp])
}

model MemoryEntry {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  character   Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  threadId    String?
  thread      ChatThread?     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  type        MemoryEntryType
  content     String          @db.Text
  createdAt   DateTime        @default(now())

  @@index([userId, characterId, type])
  @@index([threadId, type])
}

model Persona {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  avatarUrl   String?  @db.Text
  isGlobal    Boolean  @default(false)
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  selections  PersonaSelection[]
  chatThreads ChatThread[]

  @@index([userId, isGlobal])
  @@index([userId, characterId])
}

// Last persona chosen for this user+character; copied into a new ChatThread.
// The persona of a story itself is ChatThread.personaId.
model PersonaSelection {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  personaId   String
  persona     Persona   @relation(fields: [personaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, characterId])
  @@index([personaId])
}

model Favorite {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([userId, characterId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String        @id @default(cuid())
  name               String?
  email              String?       @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  credits            Int           @default(0)
  realCoins          Int           @default(0)
  verseCoins         Int           @default(0) // total = permanentCoins + expiring
  permanentCoins     Int           @default(0)
  subscriptionType         String?   @default("start")
  subscriptionEnd          DateTime?
  pendingSubscriptionType  String?
  pendingSubscriptionEnd   DateTime?
  robokassaRecurringId     String?   @unique
  bonusStreak        Int           @default(0)
  lastBonusDate      DateTime?
  dailyRequests      Int           @default(0)
  dailyRequestsDate  DateTime      @default(now())
  lastDailyBonus     DateTime?
  avatarTokens       Int           @default(10)
  lastTokenReplenish DateTime      @default(now())
  tokensUsedThisMonth Int          @default(0)
  lastTokenMonth     DateTime      @default(now())
  referralCode       String?       @unique
  referredBy         String?
  createdAt          DateTime      @default(now())
  lastSeen           DateTime      @default(now())
  acceptedTermsAt    DateTime?
  acceptedPrivacyAt  DateTime?
  selectedModelId    String?
  selectedModel      Model?        @relation(fields: [selectedModelId], references: [id])
  isSubscribed       Boolean       @default(false)
  customApiKey       String?
  accounts           Account[]
  sessions           Session[]
  creations          Creation[]
  instances          AppInstance[]
  characters         Character[]
  messages           Message[]
  favorites          Favorite[]
  memories           Memory[]
  coreMemories       CoreMemory[]
  episodicMemories   EpisodicMemory[]
  memoryEntries      MemoryEntry[]
  personas           Persona[]
  personaSelections  PersonaSelection[]
  chatThreads        ChatThread[]
  transactions       Transaction[]
  notifications      Notification[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  supportTickets     SupportTicket[]
  avatarQuotaReservations AvatarQuotaReservation[]
  characterGenerationBatches CharacterGenerationBatch[]
  firstVcPurchase FirstVcPurchase?
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  type        String
  description String
  createdAt   DateTime @default(now())
}

model PaymentEvent {
  id        String   @id @default(cuid())
  provider  String
  invoiceId String
  userId    String
  kind      String
  planId    String?
  amountRub Int?
  createdAt DateTime @default(now())
  analyticsReceipts PaymentGoalReceipt[]

  @@unique([provider, invoiceId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String   @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model AppInstance {
  id         String     @id @default(cuid())
  name       String
  templateId String
  config     String?    
  createdAt  DateTime   @default(now())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creations  Creation[]
}

model Creation {
  id           String       @id @default(cuid())
  prompt       String?      
  aspectRatio  String?
  resolution   String?
  createdAt    DateTime     @default(now())
  userId       String
  requestId    String?      @unique
  status       String       @default("processing")
  error        String?     
  appId        String?
  inputImage   String?      
  resultImage  String?      
  creditCost   Int          @default(1)
  customData   String?      
  greeting     String?      
  name         String?
  systemPrompt String?      
  category     String?
  imageUrl     String?      
  isPack       Boolean      @default(false)
  
  app          AppInstance? @relation(fields: [appId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ChatPromptState {
  id             String @id @default(cuid())
  scopeKey       String
  characterId    String
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  builderVersion Int @default(2)
  mode           String @default("character")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  promptMigrationId String?

  @@unique([scopeKey, characterId])
  @@index([characterId, builderVersion])
}

model PromptMigrationEntry {
  id                String @id @default(cuid())
  characterId       String
  character         Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  status            String @default("reviewed")
  sourceFingerprint String
  afterFingerprint  String?
  before            Json
  proposal          Json
  reviewedAt        DateTime @default(now())
  appliedAt         DateTime?
  rolledBackAt      DateTime?
  stories           PromptMigrationStory[]

  @@index([characterId, status])
  @@index([status, reviewedAt])
}

model PromptMigrationStory {
  id                  String @id @default(cuid())
  entryId             String
  entry               PromptMigrationEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  scopeKey            String
  builderVersion      Int
  mode                String
  previousMigrationId String?

  @@unique([entryId, scopeKey])
}

model PromptRollout {
  id          String @id
  finalized   Boolean @default(false)
  finalizedAt DateTime?
}

model AnonymousSession {
  id                  String                  @id @default(cuid())
  sessionId           String                  @unique
  messagesCount       Int                     @default(0)
  expiresAt           DateTime?
  transferredToUserId String?
  transferredAt       DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  messages            AnonymousMessage[]
  requests            AnonymousChatRequest[]
}

model AnonymousMessage {
  id            String            @id @default(cuid())
  sessionId     String
  session       AnonymousSession  @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  characterId   String
  role          String
  content       String            @db.Text
  requestId     String?
  createdAt     DateTime          @default(now())
  transferredAt DateTime?

  @@index([sessionId, characterId, createdAt])
  @@index([sessionId, requestId])
}

model AnonymousChatRequest {
  id                 String           @id @default(cuid())
  requestId          String
  sessionId          String
  session            AnonymousSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  characterId        String
  payloadHash        String           @default("")
  status             String
  attempt            Int              @default(1)
  leaseUntil         DateTime?
  reservedQuota      Boolean          @default(false)
  refundedAt         DateTime?
  userContent        String           @db.Text
  assistantContent   String?          @db.Text
  userMessageId      String?
  assistantMessageId String?
  remainingMessages  Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([sessionId, requestId])
  @@index([sessionId, createdAt])
  @@index([status, leaseUntil])
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model FirstVcPurchase {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId String   @unique
  checkout  Json
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

// Immutable checkout snapshot. Confirmation/revenue remains in PaymentEvent.
model PaymentOrder {
  id String @id @default(cuid())
  provider String
  invoiceId String
  userId String
  kind String
  planId String?
  packageId Int?
  period String?
  amountRub Int
  attribution Json?
  isTest Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([provider, invoiceId])
  @@index([userId, createdAt])
}

// Client-reported SDK states, never payment confirmation or proof of delivery.
model PaymentGoalReceipt {
  id String @id @default(cuid())
  eventId String
  event PaymentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  goal String
  state String
  attempts Int
  receivedAt DateTime @default(now())
  @@unique([eventId, goal])
}

model AiCostEvent {
  id                  String   @id
  operationId         String
  actorHash           String?
  // HMAC of the ChatThread id; never the raw id.
  threadHash          String?
  subscriptionType    String?
  provider            String
  providerRequestId   String?
  providerResponseId  String?
  apiSurface         String   @default("unknown")
  accountingVersion  Int      @default(1)
  providerCostSemantics String @default("unverified")
  quotaReservationId  String?
  model               String
  actualModel         String?
  purpose             String
  attempt             Int
  outcome             String
  httpStatus          Int?
  durationMs          Int?
  inputTokens         Int?
  inputCharacters     Int?
  characterRubPerMillion Float?
  outputTokens        Int?
  cachedInputTokens   Int?
  cacheWriteInputTokens Int?
  chargedVC           Int      @default(0)
  quotedVC            Int?
  audience            String   @default("system")
  usageSource         String   @default("missing")
  costSource          String
  inputRubPerMillion  Float?
  outputRubPerMillion Float?
  reportedCostRub     Float?
  providerCostNative  Float?
  providerCostCurrency String?
  usdRub              Float?
  estimatedCostRub    Float?
  createdAt           DateTime @default(now())

  @@index([createdAt, purpose])
  @@index([operationId])
  @@index([provider, providerRequestId])
  @@index([provider, providerResponseId])
  @@index([actorHash, createdAt])
}

model AvatarQuotaReservation {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  units     Int
  month     DateTime
  status    String   @default("reserved")
  createdAt DateTime @default(now())
  generation AvatarGeneration?

  @@index([userId, createdAt])
}

model AvatarGeneration {
  id String @id
  reservationId String @unique
  reservation AvatarQuotaReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  userId String
  clientKey String
  scope String
  payloadHash String
  model String
  state String @default("creating")
  providerTaskId String? @unique
  imageUrl String? @db.Text
  errorCode String?
  credits Float?
  creditRub Float @default(0.5)
  estimatedCredits Float
  leaseToken String?
  leaseUntil DateTime?
  nextPollAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clientKey])
  @@index([userId, scope, createdAt])
  @@index([state, nextPollAt])
}

model CharacterGenerationBatch {
  id String @id
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clientKey String
  state String @default("running")
  budgetKopecks Int
  spentKopecks Int @default(0)
  reservedKopecks Int @default(0)
  prices Json
  items CharacterGenerationItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([ownerId, clientKey])
  @@index([state, createdAt])
}

model CharacterGenerationItem {
  id String @id
  batchId String
  batch CharacterGenerationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  themeKey String
  position Int
  state String @default("queued")
  stage String @default("text")
  card Json?
  feedback String?
  translations Json?
  imageUrl String?
  providerTaskId String? @unique
  characterId String? @unique
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  errorCode String?
  leaseToken String?
  leaseUntil DateTime?
  nextRunAt DateTime @default(now())
  attempts CharacterGenerationAttempt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([batchId, themeKey])
  @@index([state, nextRunAt, leaseUntil])
}

model CharacterGenerationAttempt {
  id String @id
  itemId String
  item CharacterGenerationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stage String
  number Int
  state String @default("reserved")
  reservedKopecks Int
  chargedKopecks Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([itemId, stage, number])
}

model SupportTicket {
  replies           SupportReply[]
  id                String    @id @default(cuid())
  topic             String
  email             String
  message           String    @db.Text
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  status            String    @default("open")
  clientKey         String?   @unique
  payloadHash       String    @default("")
  deliveryStatus    String    @default("pending")
  deliveryAttempts  Int       @default(0)
  nextAttemptAt     DateTime?
  claimedAt         DateTime?
  claimToken        String?
  lastError         String?
  createdAt         DateTime  @default(now())

  @@index([createdAt])
  @@index([email, createdAt])
  @@index([deliveryStatus, nextAttemptAt])
}

model SupportReply {
  id String @id @default(cuid())
  ticketId String
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  clientKey String @unique
  payloadHash String
  recipient String
  sender String
  message String @db.Text
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime? @default(now())
  claimedAt DateTime?
  claimToken String?
  providerId String?
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
  @@index([status, nextAttemptAt])
}
