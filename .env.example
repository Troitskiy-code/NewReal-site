# PostgreSQL Connection Parameters
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"
DIRECT_URL="postgresql://user:password@host:port/database?schema=public"

# NextAuth Authentication Config
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Checkout Configuration
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# MUAPI Application credentials
MUAPIAPP_API_KEY="your_muapi_api_key_here"
WEBHOOK_URL="http://localhost:3000"

# Admin API (developer-only VC top-up)
ADMIN_SECRET="your_admin_secret_here"

# Robokassa payments
ROBOKASSA_MERCHANT_ID="your_merchant_id"
ROBOKASSA_PASSWORD="your_password_1"
ROBOKASSA_PASSWORD2="your_password_2"
ROBOKASSA_PASSWORD3="your_password_3"
ROBOKASSA_TEST_MODE="1"

# Daily subscription renewals
# Accepts Authorization: Bearer CRON_SECRET, x-cron-secret, or ?secret=
CRON_SECRET="your_cron_secret_here"

# RAG embeddings (disabled by default to save tokens)
ENABLE_RAG_EMBEDDINGS="false"

# Createya avatar generation
CREATEYA_API_KEY="your_createya_api_key_here"
CREATEYA_API_URL="https://api.createya.ai"

# Yandex Metrika (https://metrika.yandex.ru)
NEXT_PUBLIC_YANDEX_METRIKA_ID="112171267"

# Yandex Cloud Translate
YANDEX_FOLDER_ID=your_folder_id
YANDEX_API_KEY=your_api_key

# Password reset emails (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="NewVerse <noreply@newvers.ai>"
# or SMTP (not used by default)
SMTP_HOST=...
SMTP_PORT=...
SMTP_USER=...
SMTP_PASS=...
