# PostgreSQL Connection Parameters
# Production (RelaxDev) must include connection_limit and pool_timeout — update the panel, not only this file.
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require&connection_limit=10&pool_timeout=15"
DIRECT_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# NextAuth Authentication Config
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Checkout Configuration
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# MUAPI Application credentials
MUAPIAPP_API_KEY="your_muapi_api_key_here"
WEBHOOK_URL="http://localhost:3000"

# Admin API (developer-only VC top-up, verify-all-users)
ADMIN_SECRET="your_admin_secret_here"

# Temporary: treat users created before this ISO date as verified.
# Remove after POST /api/admin/verify-all-users with { "before": "2026-09-11T07:00:00Z" }
EMAIL_VERIFICATION_CUTOFF_DATE=2026-09-11T07:00:00Z

# Robokassa payments. OutSum is always RUB; do not send OutSumCurrency.
# Production must be 0 — "1" adds IsTest=1 to the payment URL.
ROBOKASSA_MERCHANT_ID="your_merchant_id"
ROBOKASSA_PASSWORD="your_password_1"
ROBOKASSA_PASSWORD2="your_password_2"
ROBOKASSA_PASSWORD3="your_password_3"
ROBOKASSA_TEST_MODE="0"

# Optional server-only account IDs (comma-separated) whose purchases must not train ads.
# Never use emails or expose this as NEXT_PUBLIC. Also supply to the read-only payment report for historical tests.
PAYMENT_TEST_USER_IDS=

# RelaxDev / cron-job.org
# GET or POST /api/cron/update-characters, /api/cron/renew-subscriptions, /api/cron/update-currency, /api/cron/cleanup-notifications, /api/cron/cleanup-anonymous, /api/cron/deliver-support
# Accepts Authorization: Bearer CRON_SECRET, x-cron-secret, or ?secret=
CRON_SECRET="your_cron_secret_here"

# Delete notifications older than this many days (cron: /api/cron/cleanup-notifications)
NOTIFICATION_RETENTION_DAYS=30

# Dedicated isolated database for P0/P1 integration tests. Must not equal DATABASE_URL.
# Example local docker: postgresql://postgres:p0p1_test_only@127.0.0.1:55432/nv_p0p1_test
TEST_DATABASE_URL=

# Trust X-Forwarded-For only behind a known reverse proxy.
TRUST_PROXY="0"

# Guest chat: free messages before signup
ANONYMOUS_MESSAGE_LIMIT=5

# Support inbox (Resend). Form submissions are stored and emailed here.
SUPPORT_INBOX_EMAIL="support@example.com"

# Character system prompt generation (KodikRouter)


# RAG embeddings (disabled by default to save tokens)
ENABLE_RAG_EMBEDDINGS="false"

# Createya avatar generation
CREATEYA_API_KEY="your_createya_api_key_here"
CREATEYA_API_URL="https://api.createya.ai"

# Kie avatars: automatic Seedream text / Nano Banana 2.1 reference routing
KIE_API_KEY="your_kie_api_key_here"
# Optional: same webhookHmacKey as in Kie Settings. Without it use polling + cron.
KIE_WEBHOOK_HMAC_KEY=""
# Optional: "true" lets a text model (purpose avatar_prompt, MEMORY_AI_PROVIDER) write the image scene
# from all card fields. Off or failing = deterministic template. Toggling needs no code change.
AVATAR_PROMPT_LLM_ENABLED="false"
# "true" shows the "Первый шаг" picker (style → interests → 1–3 characters) to first-time visitors.
# Needs Character.artStyle (migration 20261015120000_character_art_style) before deploy.
ONBOARDING_ENABLED="false"
# "true" gives every account free replies on the base model: 20 a day for the first 7 Moscow days
# after sign-up, then 5 a day (src/lib/freeDailyQuota.ts). Uses existing User.dailyRequests; no migration.
FREE_DAILY_QUOTA_ENABLED="false"

# Yandex Metrika (https://metrika.yandex.ru)
NEXT_PUBLIC_YANDEX_METRIKA_ID="112171267"

# Yandex Cloud Translate
YANDEX_FOLDER_ID=your_folder_id
YANDEX_API_KEY=your_api_key

# Yandex Object Storage: private bucket; application checks character visibility.
# Required for new image uploads. Never use NEXT_PUBLIC for these credentials.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=newverse-character-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Automatic character batches. Starts with npm start and resumes DB-backed jobs.
# 0 disables the internal worker; an external scheduler can POST /api/cron/generate-characters.
CHARACTER_GENERATION_WORKER_ENABLED=1
# Set to 1 only when an external scheduler is configured instead of the internal worker.
CHARACTER_GENERATION_EXTERNAL_WORKER_ENABLED=0
# Published translation tariff, used for conservative batch reservations (RUB / 1M characters).
YANDEX_TRANSLATE_COST_RUB_PER_MILLION_CHARS=500.4

# Password reset emails (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="NewVerse <noreply@newvers.ai>"
# or SMTP (not used by default)
SMTP_HOST=...
SMTP_PORT=...
SMTP_USER=...
SMTP_PASS=...

# Better Stack / Logtail (copies of debug/info/error also go to RelaxDev stdout)
LOGTAIL_SOURCE_TOKEN=your_source_token_here
LOGTAIL_INGESTING_HOST=https://sXXXXXX.region.betterstackdata.com
LOG_LEVEL=info

# Memory semantic dedup (cosine). Set DEBUG=true to log the pairwise similarity matrix.
MEMORY_DEDUP_THRESHOLD=0.80
# Apply 20261018120000_memory_facts_v2 BEFORE deploying code. Defaults preserve legacy memory.
MEMORY_V2_ENABLED=0
# Internal durable queue worker with npm start; needs CRON_SECRET. If 0, schedule
# authenticated POST /api/cron/memory-jobs externally (GET only reports status).
MEMORY_V2_WORKER_ENABLED=1

# AI accounting v2: Chat Completions usage.cost is documented in USD with markup.
# Optional explicit rate for estimates only; empty uses verified fresh CBR rates from currency cron.
AI_COST_USD_RUB=
# Optional RUB/1M overrides; otherwise Model catalog then public 2026-10-08 snapshot (19 models).
AI_COST_RATES_RUB_JSON={}
# KODIKROUTER_USAGE_COST_CURRENCY is retired; embeddings use RUB catalog estimates.
# Offline reports only: naive timestamps in the verified Kodik CSV require KODIK_COST_EXPORT_TIMEZONE=UTC.
# Apply 20261011120000_roleplay_prompt_v2 BEFORE code deployment; enable after acceptance.

# Text-provider rollout: defaults preserve KodikRouter.
CHAT_AI_PROVIDER=kodikrouter
# Temporary safe chat transport trace (start/headers/first 20 chunks/end). Errors always keep summary diagnostics.
CHAT_TRANSPORT_TRACE=0
MEMORY_AI_PROVIDER=kodikrouter
# Optional override: empty follows MEMORY_AI_PROVIDER; disabled skips all embedding API calls.
# Apply 20261011230000_deepinfra_embeddings BEFORE code deployment / enabling DeepInfra embeddings.
EMBEDDING_AI_PROVIDER=
DEEPINFRA_API_KEY=
# Character speech: Gemini 3.8 Flash-Lite uses the existing server-side KIE_API_KEY.
# Apply 20261019190000_character_speech AND 20261019230000_kie_character_speech before enabling.
# Set false for a rollout kill switch. Voice/sample settings are fixed on the server.
CHAT_SPEECH_ENABLED=true
# Optional HTTPS CONNECT proxy for DeepInfra chat, memory, embeddings and speech only.
# Empty = direct. No global HTTP(S)_PROXY or TLS exceptions required.
DEEPINFRA_PROXY_URL=
# primary: use only DEEPINFRA_PROXY_URL. No embedded VPN process is installed or started.
# auto may use a separately hosted external reserve after network failures, once configured.
DEEPINFRA_NETWORK_MODE=primary
# Optional EXTERNAL authenticated HTTP(S) CONNECT reserve; leave empty on Relaxdev for now.
# This setting alone does not install or start a VPN or proxy server.
ALLVPN_PROXY_URL=
# Telegram Mini App: optional, disabled until the SQL migration and bot setup are complete.
TELEGRAM_MINIAPP_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Optional freshness window for signed launch data, in seconds (default: 3600).
TELEGRAM_INITDATA_MAX_AGE_SECONDS=3600
# RUB actually paid / USD credited, inclusive of top-up fees; not CBR FX.
# Example confirmed top-up: 5.25 * 103.04 / 5 = 108.192
DEEPINFRA_USD_RUB=108.192
