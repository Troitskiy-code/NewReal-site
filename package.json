{
  "name": "common-saas-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "node prisma/preinstall.cjs",
    "dev": "next dev",
    "build": "node scripts/prisma-generate.cjs && next build",
    "start": "next start",
    "lint": "eslint",
    "verify:economy": "node --experimental-strip-types scripts/verify-economy.ts",
    "verify:intent": "node --experimental-strip-types scripts/verify-intent.ts",
    "verify:p0-p1": "node --experimental-strip-types --import ./scripts/alias-register.mjs scripts/verify-p0-p1.ts",
    "verify:p0-p1:repro": "node docs/p0-p1-review-repro.cjs",
    "verify:p0-p1:int": "node --experimental-strip-types --import ./scripts/alias-register.mjs scripts/integration-p0-p1.ts",
    "verify:p0-p1:browser": "node --experimental-strip-types --import ./scripts/alias-register.mjs scripts/browser-p0-p1.ts",
    "economy:acquisition": "node --experimental-strip-types --import ./scripts/alias-register.mjs scripts/economy-acquisition.ts",
    "translate:characters": "node --experimental-strip-types scripts/translate-characters.ts",
    "compress:avatars": "node --experimental-strip-types scripts/compress-avatars.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@jsquash/webp": "^1.5.0",
    "@logtail/js": "^0.5.8",
    "@logtail/node": "^0.5.8",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^9.6.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "crc-32": "^1.2.2",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.39.0",
    "i18next": "^26.4.2",
    "i18next-http-backend": "^4.0.2",
    "jimp": "^1.6.1",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "next-i18next": "^16.2.0",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.5.2",
    "react-i18next": "^17.0.13",
    "react-icons": "^5.6.0",
    "resend": "^6.26.0",
    "sharp": "^0.35.5",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.6.0",
    "tiktoken": "^1.0.22",
    "typescript": "5.9.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "19.2.18",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linuxmusl-x64": "1.3.4",
    "@img/sharp-linuxmusl-x64": "0.35.5"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
